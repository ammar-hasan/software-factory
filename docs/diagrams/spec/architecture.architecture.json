  "cards": [
    {
      "dot": "cyan",
      "title": "One writer, many readers",
      "items": [
        "The coordinator is the only component that appends to the ledger",
        "The harness takes a callback instead of a ledger handle, because it also runs in tests, in replay and in the parity suite",
        "Entries are hash-chained and never rewritten, so a run replays from them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nothing observable is computed twice",
      "items": [
        "Metrics are folded from ledger entries over a window",
        "The dashboard and the authenticated HTTP API serve the same numbers",
        "A measure with no integration behind it is unavailable with a reason, never zero"
      ]
    },
    {
      "dot": "rose",
      "title": "The definition is read, never written",
      "items": [
        "factory.yaml, the agents and the policy files are inputs the execution plane cannot write",
        "Grants are default-deny and an ungranted call is a recorded violation",
        "Changing what the factory does is a change you can review, diff and revert"
      ]
    }
  ]
