  "cards": [
    {
      "dot": "cyan",
      "title": "The budget is a property of the pack",
      "items": [
        "Each section is given a share of the budget chosen by the agent's role",
        "Overflow drops whole items from the tail, never half an item",
        "Mission, contract and toolbelt keep a protected floor, and a trim is announced"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cited, or absent",
      "items": [
        "Every item carries a citation kind and a resolvable reference",
        "An item without one is dropped rather than shown",
        "An unavailable source degrades one section with a stated reason"
      ]
    },
    {
      "dot": "violet",
      "title": "Digested, so two packs can be compared",
      "items": [
        "The digest covers the notices plus everything the pack renders",
        "It is appended to the ledger with the token count",
        "Identical inputs over the same snapshot produce an identical pack"
      ]
    }
