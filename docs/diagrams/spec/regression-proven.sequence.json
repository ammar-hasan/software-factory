  "cards": [
    {
      "dot": "cyan",
      "title": "Two checkouts, deliberately",
      "items": [
        "The gate needs per-test resolution at two commits, so the suite runs twice",
        "The parent runs in its own detached worktree; the live tree is never touched",
        "The tip's tests are carried over the parent's code: new test, old code"
      ]
    },
    {
      "dot": "rose",
      "title": "The failure class is the gate",
      "items": [
        "Only an assertion about behaviour counts as proof",
        "Import, collection, fixture, timeout and crash failures are not behavioural proof",
        "An assertion that a name merely exists is carved out for the same reason"
      ]
    },
    {
      "dot": "emerald",
      "title": "What it refuses, and what it does not",
      "items": [
        "At least one new test must fail behaviourally at the parent",
        "Invariants that pass before and after are allowed alongside it",
        "A parent that cannot be resolved is an error, which is not a pass"
      ]
    }
  ]
